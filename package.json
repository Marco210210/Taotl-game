{
  "name": "taotl",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm --filter @taotl/server dev\" \"pnpm --filter @taotl/client dev\"",
    "build": "pnpm --filter @taotl/client build && pnpm --filter @taotl/server build",
    "start": "pnpm --filter @taotl/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "concurrently": "^9.1.0"
  }
}
